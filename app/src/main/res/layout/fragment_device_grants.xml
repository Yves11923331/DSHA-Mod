<?xml version="1.0" encoding="utf-8"?>
<!-- 224 设备能力授权（方案 B · 与「设置」页同一套设计语言）

     参照物就是设置页的行：13dp 内边距 / 24dp 主色线性图标 / 13sp 粗体标题 /
     12sp 次要说明 / 右侧 16dp 箭头或开关 / 同卡片内 1dp 分隔线 / 段标题 11sp 粗体
     （上 18dp、下 8dp）/ 页标题 24sp + 12sp 副标题。

     224 只做「统一」，不再发明新样式：
       · 去掉 34dp 柔色图标底 + 18dp 图标 → 统一 24dp 主色线性图标；
       · 行内边距 14/10/8 → 统一 13dp；最小行高统一 64dp；
       · 字号 13.5sp/11sp → 统一 13sp/12sp；
       · 卡片内补 1dp 分隔线；段标题旁的小字提示收进行状态，不再与标题并列。

     ⚠ 两处层级依赖必须保住：
       1) 根节点必须是 ScrollView > LinearLayout（FullPermissionControls 用 getChildAt(0) 当容器）；
       2) computer_use_hint 的 parent 必须是「屏幕操作」那张卡（addScreenPolicyControls 往里加控件）。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_pad"
        android:paddingTop="@dimen/gap_section"
        android:paddingEnd="@dimen/page_pad"
        android:paddingBottom="@dimen/gap_section">

        <!-- ===== 页头（与设置页同尺寸） ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui2_device_grants"
            android:textSize="24sp"
            android:textColor="@color/text"
            android:includeFontPadding="false"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ui2_grants_sub"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:includeFontPadding="false" />

        <!-- ===== 设备执行通道（三合一） ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="@string/ui2_device_channels"
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:includeFontPadding="false"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <!-- Root -->
            <LinearLayout
                android:id="@+id/row_root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:padding="13dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_recovery_shield"
                    android:contentDescription="@null"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui2_channel_root"
                        android:textSize="13sp"
                        android:textColor="@color/text"
                        android:includeFontPadding="false"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/device_root_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/device_checking"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/config_root_shell"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:showText="false" />

                <ImageView
                    android:id="@+id/row_root_go"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_ui2_chevron"
                    android:contentDescription="@string/ui_m0170"
                    app:tint="@color/text_muted" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/line" />

            <!-- Shizuku -->
            <LinearLayout
                android:id="@+id/row_shizuku"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:padding="13dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_terminal"
                    android:contentDescription="@null"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui2_channel_shizuku"
                        android:textSize="13sp"
                        android:textColor="@color/text"
                        android:includeFontPadding="false"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/workspace_shizuku_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/device_checking"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/row_shizuku_go"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_ui2_chevron"
                    android:contentDescription="@string/ui_m0015"
                    app:tint="@color/text_muted" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/line" />

            <!-- ADB -->
            <LinearLayout
                android:id="@+id/row_adb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:padding="13dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_recovery_wrench"
                    android:contentDescription="@null"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui2_channel_adb"
                        android:textSize="13sp"
                        android:textColor="@color/text"
                        android:includeFontPadding="false"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/config_adb_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/device_checking"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/config_adb_enable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:showText="false" />

                <ImageView
                    android:id="@+id/row_adb_go"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_ui2_chevron"
                    android:contentDescription="@string/ui_m0031"
                    app:tint="@color/text_muted" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 屏幕操作 ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="@string/computer_use_title"
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:includeFontPadding="false"
            android:textStyle="bold" />

        <!-- computer_use_hint 的 parent 就是这张卡：addScreenPolicyControls 往里加控件 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/row_a11y"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:padding="13dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_pip_landscape"
                    android:contentDescription="@null"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui2_a11y_service"
                        android:textSize="13sp"
                        android:textColor="@color/text"
                        android:includeFontPadding="false"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/config_a11y_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/device_checking"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/row_a11y_go"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_ui2_chevron"
                    android:contentDescription="@string/ui134_screen_setup"
                    app:tint="@color/text_muted" />
            </LinearLayout>

            <!-- 说明与跳转按钮：控件保留（代码依赖 parent 与 id），视觉上隐藏 -->
            <TextView
                android:id="@+id/computer_use_hint"
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/computer_use_accessibility"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone"
                android:text="@string/ui134_screen_setup" />
        </LinearLayout>

        <!-- ===== 系统权限 ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="@string/ui2_system_permissions"
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:includeFontPadding="false"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/config_all_files"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:padding="13dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_ui2_folder"
                    android:contentDescription="@null"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/device_open_access"
                        android:textSize="13sp"
                        android:textColor="@color/text"
                        android:includeFontPadding="false"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/config_all_files_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/device_checking"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_ui2_chevron"
                    android:contentDescription="@string/device_open_access"
                    app:tint="@color/text_muted" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/line" />

            <LinearLayout
                android:id="@+id/row_battery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:padding="13dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_recovery_clock"
                    android:contentDescription="@null"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_m0191"
                        android:textSize="13sp"
                        android:textColor="@color/text"
                        android:includeFontPadding="false"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/config_battery_opt_hint"
                        style="@style/DshaText.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/ui_m0084"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/row_battery_go"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_ui2_chevron"
                    android:contentDescription="@string/ui_m0191"
                    app:tint="@color/text_muted" />
            </LinearLayout>

            <!-- 原按钮：隐藏，由行点击转发 -->
            <Button
                android:id="@+id/config_battery_opt"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone"
                android:text="@string/ui_m0191" />
        </LinearLayout>

        <!-- ===== 独立敏感能力 ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="@string/ui2_sensitive"
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:includeFontPadding="false"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/row_sms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:padding="13dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_ui_chat"
                    android:contentDescription="@null"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_m0171"
                        android:textSize="13sp"
                        android:textColor="@color/text"
                        android:includeFontPadding="false"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/device_sms_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/device_checking"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/device_sms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:showText="false" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/line" />

            <LinearLayout
                android:id="@+id/row_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:padding="13dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_plug_globe"
                    android:contentDescription="@null"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_m0066"
                        android:textSize="13sp"
                        android:textColor="@color/text"
                        android:includeFontPadding="false"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/config_cap_location_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/ui2_cap_location_sub"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/config_cap_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:showText="false" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/line" />

            <LinearLayout
                android:id="@+id/row_sensors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:padding="13dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_plug_chart"
                    android:contentDescription="@null"
                    app:tint="@color/primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_m0053"
                        android:textSize="13sp"
                        android:textColor="@color/text"
                        android:includeFontPadding="false"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/config_cap_sensors_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/ui2_cap_sensors_sub"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:includeFontPadding="false" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/config_cap_sensors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:showText="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- 隐藏的旧按钮：唯一职责是让「行点击」有地方 performClick()，Fragment 绑定不用改 -->
        <Button
            android:id="@+id/device_root_verify"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="@string/ui_m0170" />

        <Button
            android:id="@+id/workspace_shizuku_auth"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="@string/ui_m0015" />

        <Button
            android:id="@+id/device_shizuku_open"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="@string/ui_m0125" />

        <Button
            android:id="@+id/config_adb_pair"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="@string/ui_m0031" />

        <TextView
            android:id="@+id/config_guard_status"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
