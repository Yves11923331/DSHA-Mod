<?xml version="1.0" encoding="utf-8"?>
<!-- 221 插件页重构（方案 A · 分组卡片）
     原来首屏 625dp 里 543dp 被头部吃掉：页头 + tab + 社区入口 + 227dp 的「从链接安装」大卡，
     一张插件卡都看不到。现在改成：
       页头（标题+统计） → 搜索 → 「添加插件」三行卡（链接输入默认折叠）→ 任务条 → 「已安装」+ 工具
     功能一个不丢：搜索/排序/隐藏内置/检查更新/刷新/下载源/取消/导入导出 都还在各自的位置。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 页头：标题 + 统计 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="插件"
        android:textSize="22sp"
        android:textColor="@color/text"
        android:includeFontPadding="false"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pluginStat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="正在读取…"
        android:textSize="11.5sp"
        android:textColor="@color/text_secondary"
        android:includeFontPadding="false" />

    <!-- 搜索（常驻，不藏进图标） -->
    <EditText
        android:id="@+id/pluginSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="44dp"
        android:background="@drawable/bg_input"
        android:hint="搜索插件"
        android:singleLine="true"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:importantForAutofill="no"
        android:paddingStart="@dimen/gap_control"
        android:paddingEnd="@dimen/gap_control"
        android:textColor="@color/text"
        android:textColorHint="@color/text_muted"
        android:textSize="13sp"
        android:drawableStart="@drawable/ic_ui_search"
        android:drawablePadding="10dp" />

    <!-- ===== 分组：添加插件 ===== -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="2dp"
        android:text="添加插件"
        android:textSize="11sp"
        android:textColor="@color/text_muted"
        android:includeFontPadding="false"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical">

        <!-- ① 社区插件生态 -->
        <LinearLayout
            android:id="@+id/btnPluginWebsite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_soft">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_plugins"
                    android:contentDescription="@null"
                    app:tint="@color/primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="社区插件生态"
                    android:textSize="13.5sp"
                    android:textColor="@color/text"
                    android:includeFontPadding="false"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="官方与社区插件目录"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_ui2_chevron"
                android:contentDescription="@null"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@color/line" />

        <!-- ② 从链接安装（默认折叠，点这行展开） -->
        <LinearLayout
            android:id="@+id/pluginLinkToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_soft">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_ui_link"
                    android:contentDescription="@null"
                    app:tint="@color/primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="从链接安装"
                    android:textSize="13.5sp"
                    android:textColor="@color/text"
                    android:includeFontPadding="false"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="仓库 / Release / 压缩包直链"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <ImageView
                android:id="@+id/pluginLinkChevron"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_chevron_down"
                android:contentDescription="@null"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <!-- 折叠区：链接输入 + 粘贴/识别 + 提示 -->
        <LinearLayout
            android:id="@+id/pluginLinkSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/appbar_github_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:background="@drawable/bg_input"
                android:hint="粘贴插件链接或 owner/repo"
                android:inputType="textUri"
                android:imeOptions="actionGo"
                android:singleLine="true"
                android:importantForAutofill="no"
                android:paddingStart="@dimen/gap_control"
                android:paddingEnd="@dimen/gap_control"
                android:textColor="@color/text"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/pluginLinkHint"
                style="@style/DshaText.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPluginPaste"
                    style="@style/Widget.DSHA.ToolbarAction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ui_m0179"
                    android:background="@drawable/bg_polished_action"
                    android:drawableStart="@drawable/ic_ui_copy"
                    android:drawablePadding="8dp"
                    android:minHeight="48dp" />

                <TextView
                    android:id="@+id/btnPluginInstall"
                    style="@style/PluginAction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/gap_tight"
                    android:layout_weight="1"
                    android:text="@string/ui2_resolve"
                    android:background="@drawable/bg_polished_primary"
                    android:textColor="@color/polished_primary_text"
                    android:minHeight="48dp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@color/line" />

        <!-- ③ 导入本地插件 -->
        <LinearLayout
            android:id="@+id/btnImport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_soft">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_ui_import"
                    android:contentDescription="@null"
                    app:tint="@color/primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ui2_import"
                    android:textSize="13.5sp"
                    android:textColor="@color/text"
                    android:includeFontPadding="false"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/ui2_import_sub"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_ui2_chevron"
                android:contentDescription="@null"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@color/line" />

        <!-- ④ 导出本地插件（原来在 footer，跟着导入一起收到这里） -->
        <LinearLayout
            android:id="@+id/btnExport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_soft">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_ui_export"
                    android:contentDescription="@null"
                    app:tint="@color/primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ui2_export"
                    android:textSize="13.5sp"
                    android:textColor="@color/text"
                    android:includeFontPadding="false"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/ui2_export_sub"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_ui2_chevron"
                android:contentDescription="@null"
                app:tint="@color/text_muted" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== 任务条（有任务/有消息时才出现）===== -->
    <LinearLayout
        android:id="@+id/taskBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/pluginBusy"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/primary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statusText"
            style="@style/DshaText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="24dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/ui_m0134"
            android:gravity="center_vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPluginDownloadSource"
                style="@style/DshaText.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="36dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:textColor="@color/primary"
                android:textSize="11.5sp" />

            <Button
                android:id="@+id/btnCancelPluginTask"
                style="@style/Widget.DSHA.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:visibility="gone"
                android:text="@string/ui_m0079" />
        </LinearLayout>

        <TextView
            android:id="@+id/pluginDownloadHint"
            style="@style/DshaText.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- ===== 分组：已安装 + 工具 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/pluginInstalledTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:text="已安装"
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:includeFontPadding="false"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnSort"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_down"
            android:contentDescription="@string/plugin_sort_title"
            app:tint="@color/text_secondary" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnPluginUpdates"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_plugin_scan"
            android:contentDescription="@string/ui_m0018"
            app:tint="@color/text_secondary" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_ui_refresh"
            android:contentDescription="@string/ui_m0158"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- 隐藏内置开关（221 起收进「排序与筛选」弹窗，这里保留控件以兼容旧逻辑但不显示） -->
    <CheckBox
        android:id="@+id/chkHideBuiltin"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
