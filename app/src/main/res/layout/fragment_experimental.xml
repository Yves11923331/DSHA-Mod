<?xml version='1.0' encoding='utf-8'?>
<!--
  设置 · 实验功能：目前只有「应用沙箱访问」一个开关。
  结构与其它设置子页一致：ConfigLabel 分组标题 + ConfigCard 卡片 + ConfigRow 行内开关；
  文字全部由 ExperimentalFragment 经 UiText 设置，偏好只走 ConfigStore 的一个键。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/experimental_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shell_bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/config_page_top"
        android:paddingBottom="@dimen/shell_page_bottom">

        <TextView
            android:id="@+id/experimental_intro"
            style="@style/ShellStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/config_page_pad_h"
            android:layout_marginEnd="@dimen/config_page_pad_h"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/config_page_pad_h"
            android:paddingEnd="@dimen/config_page_pad_h">

            <TextView
                android:id="@+id/experimental_label_sandbox"
                style="@style/ConfigLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                style="@style/ConfigCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/experimental_sandbox_row"
                    style="@style/ConfigRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/experimental_sandbox_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:importantForAccessibility="noHideDescendants">

                        <TextView
                            android:id="@+id/experimental_sandbox_title"
                            style="@style/ConfigRowTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/experimental_sandbox_sub"
                            style="@style/ConfigRowSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/experimental_sandbox"
                        style="@style/ConfigSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
