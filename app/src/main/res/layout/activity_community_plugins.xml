<?xml version="1.0" encoding="utf-8"?>
<!-- 215「社区插件生态」页：页头 + 来源筛选（官方/社区/本地）+ 插件卡 + 空态。
     口径与竖屏其余页面一致：page_bg 浅底、白卡 + 1px 边、零阴影、24dp 主色线性图标。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <!-- 顶栏：返回 + 标题 + 刷新。与主界面 app_bar 同高、同色。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/appbar_glass"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/cpBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:padding="10dp"
            android:src="@drawable/ic_ui_back"
            app:tint="@color/text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:text="社区插件"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/cpRefresh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="刷新插件目录"
            android:padding="10dp"
            android:src="@drawable/ic_ui_refresh"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke"
        android:background="@color/line" />

    <!-- 页头 + 来源筛选 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_pad"
        android:paddingTop="@dimen/gap_section"
        android:paddingEnd="@dimen/page_pad">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="社区插件"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:includeFontPadding="false"
            android:text="官方与社区插件目录，选择来源查看"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_section"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/cpFilterOfficial"
                style="@style/PluginAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_plugin_segment"
                android:minHeight="40dp"
                android:text="官方"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/cpFilterCommunity"
                style="@style/PluginAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_plugin_segment"
                android:minHeight="40dp"
                android:text="社区"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/cpFilterLocal"
                style="@style/PluginAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_plugin_segment"
                android:minHeight="40dp"
                android:text="本地"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 列表 / 空态 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cpList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/page_pad"
            android:paddingTop="14dp"
            android:paddingEnd="@dimen/page_pad"
            android:paddingBottom="@dimen/gap_section" />

        <LinearLayout
            android:id="@+id/cpEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_pad"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="@dimen/page_pad"
            android:background="@drawable/bg_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="32dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_badge_local">

                <ImageView
                    android:id="@+id/cpEmptyIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_plugins"
                    app:tint="@color/text_muted" />
            </FrameLayout>

            <TextView
                android:id="@+id/cpEmptyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="镜像不可达，已回退官方源"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cpEmptyDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:text="当前来源没有可显示的插件。"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/cpEmptyAction"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_pill_action"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="96dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="重试"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- 镜像回退提示条 -->
    <LinearLayout
        android:id="@+id/cpNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_pad"
        android:layout_marginEnd="@dimen/page_pad"
        android:layout_marginBottom="@dimen/gap_section"
        android:background="@drawable/bg_notice_warn"
        android:orientation="horizontal"
        android:paddingStart="13dp"
        android:paddingTop="11dp"
        android:paddingEnd="13dp"
        android:paddingBottom="11dp"
        android:visibility="gone">

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_dot_warn" />

        <TextView
            android:id="@+id/cpNoticeText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/warn"
            android:textSize="11.5sp" />
    </LinearLayout>
</LinearLayout>
